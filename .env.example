# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Comma-separated Telegram numeric user IDs that get admin access
ADMIN_IDS=111111111,222222222

# ---- Telegram connection mode ----
# How the bot reaches Telegram: DIRECT | PROXY | XRAY
CONNECT_MODE=DIRECT

# PROXY mode: route through an http/https/socks5 proxy.
# (Legacy PROXY_MODE=ON also forces PROXY mode if CONNECT_MODE is left blank.)
PROXY_MODE=OFF
# Supports http, https, and socks5. Examples:
#   socks5://127.0.0.1:1080
#   socks5://user:pass@host:1080
#   http://127.0.0.1:8080
PROXY_URL=

# XRAY mode: launch a local xray-core from a share link and route Telegram
# through the SOCKS proxy it exposes. Requires xray-core installed on the host.
# Paste a full config link (vless/vmess/trojan/ss are supported; hysteria is not).
XRAY_CONFIG_URL=
# Path to the xray binary (or just "xray" if it's on PATH).
XRAY_BIN=xray
# Local SOCKS port xray will listen on for the bot to use.
XRAY_SOCKS_PORT=10808

# 3X-UI panels are configured in the bot: Admin Panel → Panels (not in .env).

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./vpnbot.db

# ---- Bot UX ----
DEFAULT_LANG=en
SUPPORT_CONTACT=@your_support
BRAND_NAME=My VPN

# ---- Card-to-card payment ----
CARD_NUMBER=6037-9911-1111-1111
CARD_HOLDER=John Doe
# Currency label shown to users for manual/card payments
FIAT_CURRENCY=IRR

# ---- Telegram Stars ----
# Stars are native; no extra credentials needed. Toggle availability:
STARS_ENABLED=true

# ---- Crypto (NowPayments) ----
CRYPTO_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Public URL where this bot's aiohttp server is reachable for IPN callbacks
# e.g. https://bot.example.com  (the IPN path is /nowpayments/ipn)
PUBLIC_BASE_URL=
# Host/port for the local aiohttp webhook server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
